# 复制为 .env 后填写。全部留空也能跑：eval --offline 只回放录制数据。

# 大模型：任何 OpenAI 兼容接口（vLLM / SGLang / Ollama / 混元 / DeepSeek ...），地址写到 /v1 为止
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# 可选：推理强度，模型支持时生效（low / medium / high）
LLM_REASONING_EFFORT=

# 元宝搜索 SearchPro
YUANBAO_API_KEY=

# 钉钉自定义机器人（留空则只打印，不发送）
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# watch 模式：巡检间隔（秒）和要挂载的仓库目录
SCAN_INTERVAL=86400
REPOS_DIR=./scenarios
